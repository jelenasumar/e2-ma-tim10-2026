            android:id="@+id/action_home_to_spojnice"
            app:destination="@id/spojniceFragment" />

        <action
            android:id="@+id/action_home_to_regionMap"
            app:destination="@id/regionMapFragment" />

        <action
            android:id="@+id/action_home_to_ranking"
            app:destination="@id/rankingFragment" />

        <action
            android:id="@+id/action_profile_to_changePassword"
            app:destination="@id/changePassword" />

        <action
            android:id="@+id/action_home_to_regionChat"
            app:destination="@id/regionChatFragment" />

        <action
            android:id="@+id/action_regionMap_to_challengeSession"
            app:destination="@id/challengeSessionFragment" />


