        <action
            android:id="@+id/action_home_to_skocko"
            app:destination="@id/skockoFragment" />

        <action
            android:id="@+id/action_home_to_notifications"
            app:destination="@id/notificationsFragment" />

        <action
            android:id="@+id/action_home_to_dailyMissions"
            app:destination="@id/dailyMissionsFragment" />

        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />

        <action
            android:id="@+id/action_home_to_inviteFriends"
            app:destination="@id/inviteFriendsFragment" />

        <action
            android:id="@+id/action_home_to_onlineMatchmaking"
