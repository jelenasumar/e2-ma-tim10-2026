        android:id="@+id/koZnaZnaFragment"
        android:name="com.example.slagalica.ui.games.KoZnaZnaFragment"
        android:label="@string/game_ko_zna_zna" />

    <fragment
        android:id="@+id/spojniceFragment"
        android:name="com.example.slagalica.ui.games.SpojniceFragment"
        android:label="@string/game_spojnice" />

    <fragment
        android:id="@+id/changePassword"
        android:name="com.example.slagalica.ui.profile.ChangePasswordFragment"
        android:label="@string/change_password" />

    <fragment
        android:id="@+id/regionMapFragment"
        android:name="com.example.slagalica.ui.region.RegionMapFragment"
        android:label="@string/region_map_title">

        <action
            android:id="@+id/action_regionMap_to_leaderboard"
            app:destination="@id/regionLeaderboardFragment" />
    </fragment>

    <fragment
        android:id="@+id/regionLeaderboardFragment"
        android:name="com.example.slagalica.ui.region.RegionLeaderboardFragment"
        android:label="@string/region_leaderboard_title" />

    <fragment
        android:id="@+id/rankingFragment"
        android:name="com.example.slagalica.ui.ranking.RankingFragment"
        android:label="@string/ranking_title" />

