        android:name="com.example.slagalica.ui.games.SkockoFragment"
        android:label="Skočko" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.slagalica.ui.notifications.NotificationsFragment"
        android:label="Notifikacije" />

    <fragment
