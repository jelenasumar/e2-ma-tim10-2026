        <action
            android:id="@+id/action_home_to_tournament"
            app:destination="@id/tournamentFragment" />

        <action
            android:id="@+id/action_home_to_roomSession"
            app:destination="@id/roomSessionFragment" />

        <action
            android:id="@+id/action_home_to_koZnaZna"
