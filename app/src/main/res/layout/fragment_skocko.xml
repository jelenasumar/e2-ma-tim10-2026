<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.games.SkockoFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/skocko"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/skockoGameHeader"
            android:name="com.example.slagalica.ui.games.GameHeaderFragment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gameTitle" />

        <TextView
            android:id="@+id/symbolsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/available_symbols"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skockoGameHeader" />

        <LinearLayout
            android:id="@+id/symbolsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/symbolsTitle">

            <TextView
                android:id="@+id/skockoSymbolSkocko"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_skocko_label"
                android:text="@string/skocko_symbol_skocko"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/skockoSymbolSquare"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_square_label"
                android:text="@string/skocko_symbol_square"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/skockoSymbolCircle"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_circle_label"
                android:text="@string/skocko_symbol_circle"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/skockoSymbolHeart"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_heart_label"
                android:text="@string/skocko_symbol_heart"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/skockoSymbolTriangle"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_triangle_label"
                android:paddingEnd="2dp"
                android:paddingStart="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="4dp"
                android:text="@string/skocko_symbol_triangle"
                android:textSize="30sp"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/skockoSymbolStar"
                style="@style/SkockoSymbolBox"
                android:contentDescription="@string/skocko_symbol_star_label"
                android:text="@string/skocko_symbol_star"
                tools:ignore="TextContrastCheck" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/attemptsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/symbolsContainer">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/skocko_player_attempts_label"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt1Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt1Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt1Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt1Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt1Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt2Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt2Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt2Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt2Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt2Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt3Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt3Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt3Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt3Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt3Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt4Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt4Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt4Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt4Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt4Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt5Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt5Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt5Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt5Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt5Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>

            <LinearLayout style="@style/SkockoAttemptRow" android:orientation="horizontal">
                <TextView android:id="@+id/skockoAttempt6Cell1" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt6Cell2" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt6Cell3" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt6Cell4" style="@style/SkockoCell" />
                <TextView android:id="@+id/skockoAttempt6Result" style="@style/SkockoResultCell" android:text="@string/skocko_result_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/skockoDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:background="#BDBDBD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/attemptsContainer" />

        <TextView
            android:id="@+id/opponentAttemptLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/skocko_opponent_attempt_label"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skockoDivider" />

        <LinearLayout
            android:id="@+id/opponentAttemptRow"
            style="@style/SkockoAttemptRow"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/opponentAttemptLabel">

            <TextView android:id="@+id/skockoOpponentCell1" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoOpponentCell2" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoOpponentCell3" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoOpponentCell4" style="@style/SkockoCell" />
        </LinearLayout>

        <TextView
            android:id="@+id/finalCombinationLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/skocko_solution_label"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/opponentAttemptRow" />

        <LinearLayout
            android:id="@+id/finalCombinationRow"
            style="@style/SkockoAttemptRow"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/finalCombinationLabel">

            <TextView android:id="@+id/skockoFinalCell1" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoFinalCell2" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoFinalCell3" style="@style/SkockoCell" />
            <TextView android:id="@+id/skockoFinalCell4" style="@style/SkockoCell" />
        </LinearLayout>

        <Button
            android:id="@+id/submitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/finalCombinationRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
