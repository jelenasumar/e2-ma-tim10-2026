rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMatchParticipant() {
      return isSignedIn()
        && resource.data.keys().hasAll(['hostUid', 'guestUid'])
        && (resource.data.hostUid == request.auth.uid
            || resource.data.guestUid == request.auth.uid);
    }

    function isMutualFriendAdd(userId) {
      return isSignedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds'])
        && request.auth.uid in request.resource.data.friendIds;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if isMutualFriendAdd(userId);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens']);

      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && (
          request.auth.uid == userId
          || (
            request.resource.data.keys().hasAny(['fromUid'])
            && request.resource.data.fromUid == request.auth.uid
          )
        );
      }

      match /friends/{friendId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /game_invites/{inviteId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string;

      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow update: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
    }

    match /matchmaking_queue/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.resource.data.uid == request.auth.uid
        || (
          resource.data.status == "WAITING"
          && request.resource.data.status == "MATCHED"
          && request.resource.data.roomId is string
        )
      );
      allow delete: if isSignedIn()
        && userId == request.auth.uid;
    }

    match /tournament_queue/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

   match /username_lookup/{usernameLower} {
  	allow read: if true;

  	allow create: if isSignedIn()
   	  && request.resource.data.uid == request.auth.uid
  	  && request.resource.data.keys().hasOnly(['uid', 'email'])
  	  && request.resource.data.email is string
  	  && request.resource.data.uid is string;

 	 allow update, delete: if false;
	}

    match /kzz_lobbies/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid
        || (
          request.resource.data.guestUid == request.auth.uid
          && (!('guestUid' in resource.data)
              || resource.data.guestUid == null
              || resource.data.guestUid == request.auth.uid)
        )
      );

      allow delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid;
    }

    match /kzz_matches/{matchId} {
      allow read: if isMatchParticipant();

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if isMatchParticipant();
    }

    match /association_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /kzz_questions/{questionId} {
      allow read: if isSignedIn();
    }

    match /spojnice_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /korak_po_korak_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();

      match /games/{gameId} {
        allow read, write: if isSignedIn();
      }
    }

    match /match_results/{matchId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && (request.resource.data.hostUid == request.auth.uid
            || request.resource.data.guestUid == request.auth.uid);

      allow update: if isSignedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.guestUid == request.auth.uid)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.guestUid == resource.data.guestUid;
    }

    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
