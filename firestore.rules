rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMatchParticipant() {
      return isSignedIn()
        && resource.data.keys().hasAll(['hostUid', 'guestUid'])
        && (resource.data.hostUid == request.auth.uid
            || resource.data.guestUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read, create, update: if isSignedIn() && request.auth.uid == userId;
      }
    }

   match /username_lookup/{usernameLower} {
  	allow read: if true;

  	allow create: if isSignedIn()
   	  && request.resource.data.uid == request.auth.uid
  	  && request.resource.data.keys().hasOnly(['uid', 'email'])
  	  && request.resource.data.email is string
  	  && request.resource.data.uid is string;

 	 allow update, delete: if false;
	}

    match /kzz_lobbies/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid
        || (
          request.resource.data.guestUid == request.auth.uid
          && (!('guestUid' in resource.data)
              || resource.data.guestUid == null
              || resource.data.guestUid == request.auth.uid)
        )
      );

      allow delete: if isSignedIn()
        && resource.data.hostUid == request.auth.uid;
    }

    match /kzz_matches/{matchId} {
      allow read: if isMatchParticipant();

      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if isMatchParticipant();
    }

    match /association_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /kzz_questions/{questionId} {
      allow read: if isSignedIn();
    }

    match /spojnice_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /korak_po_korak_puzzles/{puzzleId} {
      allow read: if isSignedIn();
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();

      match /games/{gameId} {
        allow read, write: if isSignedIn();
      }
    }

    match /regions/{regionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
